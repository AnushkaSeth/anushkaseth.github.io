overall_corr <- cor(
penguins$bill_length_mm,
penguins$bill_depth_mm,
use = "complete.obs"
)
library(palmerpenguins)
library(tidyverse)
library(ggplot2)
penguins <- penguins
overall_corr <- cor(
penguins$bill_length_mm,
penguins$bill_depth_mm,
use = "complete.obs"
)
print(overall_corr)
overall_corr <- cor(
penguins$bill_length_mm,
penguins$bill_depth_mm,
use = "complete.obs"
)
print(round(overall_corr, 2))
penguins %>%
group_by(species) %>%
summarise(
correlation = round(
cor(
bill_length_mm,
bill_depth_mm,
use = "complete.obs"
),
2
)
)
ggplot(
penguins,
aes(
x = bill_length_mm,
y = bill_depth_mm,
colour = species
)
) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
labs(
title = "Bill Length vs Bill Depth by Species",
x = "Bill Length (mm)",
y = "Bill Depth (mm)",
colour = "Species"
) +
theme_minimal()
penguins <- penguins %>%
mutate(
bci = body_mass_g / flipper_length_mm
)
penguins %>%
select(
species,
sex,
body_mass_g,
flipper_length_mm,
bci
) %>%
head()
bci_profile <- penguins %>%
group_by(species, sex) %>%
summarise(
bci = mean(bci, na.rm = TRUE),
.groups = "drop"
)
print(bci_profile)
bci_profile <- penguins %>%
group_by(species, sex) %>%
summarise(
bci = mean(bci, na.rm = TRUE),
.groups = "drop"
)
bci_ranked <- bci_profile %>%
arrange(desc(bci)) %>%
mutate(rank = row_number())
print(bci_ranked)
ggplot(
bci_profile,
aes(
x = species,
y = bci,
fill = sex
)
) +
geom_col(position = "dodge") +
labs(
title = "Average Body Condition Index by Species and Sex",
x = "Species",
y = "Average BCI",
fill = "Sex"
) +
theme_minimal()
ggplot(
penguins,
aes(
x = bill_length_mm,
y = bill_depth_mm,
colour = species
)
) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
labs(
title = "Bill Length vs Bill Depth by Species",
x = "Bill Length (mm)",
y = "Bill Depth (mm)",
colour = "Species"
) +
theme_minimal()
